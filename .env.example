# OpenSky Network credentials (optional - unauthenticated requests work but are rate-limited)
# Sign up free at https://opensky-network.org/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Default map center (optional)
NEXT_PUBLIC_DEFAULT_LAT=20
NEXT_PUBLIC_DEFAULT_LNG=0
NEXT_PUBLIC_DEFAULT_ZOOM=3

# Refresh interval in milliseconds (default: 10000 = 10 seconds)
NEXT_PUBLIC_REFRESH_INTERVAL=10000
